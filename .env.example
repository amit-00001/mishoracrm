APP_NAME="Mishora CRM"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=Asia/Kolkata
# APP_URL=https://saas-crm.test/
# APP_BASE_DOMAIN=saas-crm.test
APP_URL=http://localhost:8000/
APP_BASE_DOMAIN=localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
APP_MAINTENANCE_STORE=database

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=lrv_saas_crm
DB_USERNAME=root
DB_PASSWORD=
# DB_COLLATION=utf8mb4_unicode_ci
DB_COLLATION=utf8mb4_general_ci

# Aiven (MySQL) — uncomment and fill these to use Aiven's managed MySQL instead of local MySQL
# DB_CONNECTION=mysql
# DB_HOST=your-service-name.aivencloud.com
# DB_PORT=your-aiven-port
# DB_DATABASE=defaultdb
# DB_USERNAME=avnadmin
# DB_PASSWORD=your-aiven-db-password
# MYSQL_ATTR_SSL_CA=/absolute/path/to/aiven-ca.pem

SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
# SESSION_DOMAIN=saas-crm.test
SESSION_DOMAIN=null
# SESSION_DOMAIN=.saas-crm.test
SESSION_SECURE_COOKIE=false

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
CACHE_STORE=file

MEMCACHED_HOST=127.0.0.1

# REDIS_CLIENT=phpredis
# REDIS_HOST=127.0.0.1
# REDIS_PASSWORD=null
# REDIS_PORT=6379

MAIL_MAILER=log
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=your_webhook_secret_here

# REDIS_HOST=127.0.0.1
# REDIS_PORT=6379

TELESCOPE_ENABLED=True

# SANCTUM_STATEFUL_DOMAINS=saas-crm.test,tata.saas-crm.test

FIREBASE_CREDENTIALS=storage/firebase/firebase-service-account.json
